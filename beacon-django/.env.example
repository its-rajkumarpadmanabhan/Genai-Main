# --- Gemini engine ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Django ---
# Long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=*

# --- JWT ---
# Separate JWT secret (optional — falls back to DJANGO_SECRET_KEY if not set)
JWT_SECRET=change_this_to_a_long_random_string

# --- Database ---
# Defaults to a local SQLite file if not set. For production use Postgres, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/beacon
DATABASE_URL=sqlite:///./beacon_users.db

# --- SMTP email delivery (welcome email + password reset) ---
# Without these set, emails are logged to the console instead of sent (dev mode).
#
# Example using a Gmail App Password (requires 2FA enabled on the Google account,
# then create an App Password at https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Beacon Recovery Platform
#
# Example using SendGrid SMTP relay instead:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your_sendgrid_api_key
# SMTP_FROM_EMAIL=verified_sender@yourdomain.com

# Base URL used to build the password-reset link sent by email.
# Must match wherever the app is actually hosted.
FRONTEND_BASE_URL=http://localhost:8000
